generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MemoryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  PASSWORD_PROTECTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum QRStatus {
  ACTIVE
  DISABLED
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
}

enum TemplateCategory {
  ROMANTIC
  ANNIVERSARY
  BIRTHDAY
  PROPOSAL
  VINTAGE
  CELEBRATION
}

enum MediaType {
  IMAGE
  VIDEO
  VOICE_NOTE
}

enum ActionType {
  MEMORY_CREATED
  MEMORY_UPDATED
  MEMORY_DELETED
  MEMORY_ARCHIVED
  QR_GENERATED
  TEMPLATE_UPDATED
  SETTINGS_CHANGED
  ADMIN_LOGIN
  ORDER_UPDATED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  avatar       String
  phone        String?
  role         Role       @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activityLogs ActivityLog[]
}

model Template {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  category       TemplateCategory
  thumbnail      String
  description    String
  previewImages  String[]
  status         TemplateStatus   @default(ACTIVE)
  isPremium      Boolean          @default(false)
  displayOrder   Int              @default(0)
  version        String           @default("1.0.0")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  memories Memory[]
}

model BackgroundMusic {
  id        String @id @default(cuid())
  title     String
  artist    String
  musicUrl  String
  thumbnail String?
  category  String
  duration  String

  memories  Memory[]
}

model Memory {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  subtitle      String        @default("")
  recipientName String
  senderName    String
  relationship  String        @default("Loved One")
  coverImage    String?
  coverVideo    String?
  templateId    String
  musicId       String?
  status        MemoryStatus  @default(DRAFT)
  visibility    Visibility    @default(PUBLIC)
  viewCount     Int           @default(0)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  template    Template       @relation(fields: [templateId], references: [id])
  music       BackgroundMusic? @relation(fields: [musicId], references: [id])
  letter      Letter?
  photos      Photo[]
  videos      Video[]
  voiceNotes  VoiceNote[]
  timeline    TimelineEvent[]
  quotes      Quote[]
  wishes      Wish[]
  qrCode          QRCodeData?
  orders          Order[]
  viewEvents      MemoryViewEvent[]

  @@index([createdAt])
  @@index([templateId])
  @@index([status])
}

model Letter {
  id             String   @id @default(cuid())
  memoryId       String   @unique
  title          String   @default("My Dearest,")
  content        String
  fontStyle      String   @default("serif")
  textAlignment  String   @default("left")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

model Photo {
  id           String @id @default(cuid())
  memoryId     String
  imageUrl     String
  caption      String?
  displayOrder Int    @default(0)

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model Video {
  id           String @id @default(cuid())
  memoryId     String
  videoUrl     String
  thumbnail    String?
  caption      String?
  displayOrder Int    @default(0)

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model VoiceNote {
  id           String @id @default(cuid())
  memoryId     String
  title        String
  audioUrl     String
  duration     String @default("00:30")
  displayOrder Int    @default(0)

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model TimelineEvent {
  id          String  @id @default(cuid())
  memoryId    String
  title       String
  description String
  eventDate   String
  image       String?
  displayOrder Int    @default(0)

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model Quote {
  id           String @id @default(cuid())
  memoryId     String
  quote        String
  author       String
  displayOrder Int    @default(0)

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model Wish {
  id          String   @id @default(cuid())
  memoryId    String
  personName  String
  message     String
  createdAt   DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model QRCodeData {
  id              String    @id @default(cuid())
  memoryId        String    @unique
  qrCodeImage     String    @default("")
  qrValue         String
  scanCount       Int       @default(0)
  status          QRStatus  @default(ACTIVE)
  foregroundColor String    @default("#000000")
  backgroundColor String    @default("#FFFFFF")
  logoUrl         String?
  style           String    @default("standard")
  downloadCount   Int       @default(0)
  lastScannedAt   DateTime?
  createdAt       DateTime  @default(now())

  memory        Memory            @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  scanLogs      QRScanEvent[]
  downloadLogs  QRDownloadEvent[]

  @@index([createdAt])
}

model QRScanEvent {
  id        String   @id @default(cuid())
  qrId      String
  ipAddress String   @default("")
  userAgent String   @default("")
  referrer  String   @default("")
  createdAt DateTime @default(now())

  qr QRCodeData @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId])
  @@index([createdAt])
  @@index([qrId, createdAt])
}

model MemoryViewEvent {
  id         String   @id @default(cuid())
  memoryId   String
  deviceType String   @default("desktop")
  browser    String   @default("")
  referrer   String   @default("")
  ipAddress  String   @default("")
  createdAt  DateTime @default(now())

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([createdAt])
  @@index([deviceType])
  @@index([browser])
  @@index([referrer])
  @@index([memoryId, createdAt])
  @@index([createdAt, deviceType])
  @@index([createdAt, browser])
  @@index([createdAt, referrer])
}

model QRDownloadEvent {
  id        String   @id @default(cuid())
  qrId      String
  format    String   @default("png")
  ipAddress String   @default("")
  createdAt DateTime @default(now())

  qr QRCodeData @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId])
  @@index([createdAt])
  @@index([qrId, createdAt])
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique
  memoryId       String
  customerName   String
  customerPhone  String
  customerEmail  String
  price          Float
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(PENDING)
  templateName   String
  createdAt      DateTime     @default(now())

  memory Memory @relation(fields: [memoryId], references: [id])

  @@index([memoryId])
  @@index([createdAt])
}

model MediaItem {
  id         String    @id @default(cuid())
  type       MediaType
  url        String
  name       String
  size       String
  mimeType   String
  publicId   String?
  uploadedBy String
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([type])
}

model SiteSettings {
  id                String  @id @default(cuid())
  siteName          String  @default("Memory Gift")
  siteLogo          String  @default("")
  favicon           String  @default("")
  primaryColor      String  @default("#E11D48")
  secondaryColor    String  @default("#D97706")
  supportEmail      String  @default("concierge@memorygift.com")
  phone             String  @default("")
  address           String  @default("")
  city              String  @default("")
  facebook          String  @default("")
  instagram         String  @default("")
  youtube           String  @default("")
  twitter           String  @default("")
  linkedin          String  @default("")
  tiktok            String  @default("")
  whatsapp          String  @default("")
  metaTitle         String  @default("")
  metaDescription   String  @default("")
  ogImage           String  @default("")
  twitterHandle     String  @default("")
  maintenanceMode   Boolean @default(false)
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  message    String
  isRead     Boolean  @default(false)
  ipAddress  String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
  @@index([email])
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  subscribedAt   DateTime @default(now())
  unsubscribedAt DateTime?
  isActive       Boolean  @default(true)

  @@index([subscribedAt])
  @@index([isActive])
}

model ActivityLog {
  id          String     @id @default(cuid())
  adminId     String
  adminName   String
  action      ActionType
  target      String
  description String
  ipAddress   String     @default("127.0.0.1")
  browser     String     @default("Browser App Engine")
  createdAt   DateTime   @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}
