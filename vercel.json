{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "framework": "node",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/memory/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
